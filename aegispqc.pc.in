prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: AegisPQC
Description: Hybrid Post-Quantum Cryptography & Session Layer Library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -laegispqc_core
Cflags: -I${includedir}